# ==============================================================================
# MARKET SÉNÉGAL - CONFIGURATION D'ENVIRONNEMENT PRODUCTION & CLOUD RUN (EXEMPLES)
# 
# IMPORTANT : Toutes les valeurs contenues dans ce fichier sont des EXEMPLES FICTIFS.
# Ne mettez AUCUN secret réel dans ce fichier ni dans Git.
#
# SUR GOOGLE CLOUD RUN :
# 1. Créez vos secrets dans Secret Manager (Console GCP > Sécurité > Secret Manager) :
#    - db-url (DATABASE_URL)
#    - session-secret (SESSION_SECRET)
#    - admin-init-password (ADMIN_INITIAL_PASSWORD)
#    - s3-secret-key (S3_SECRET_ACCESS_KEY)
#    - smtp-password (SMTP_PASSWORD)
#    - google-client-secret (GOOGLE_CLIENT_SECRET)
#    - gemini-api-key (GEMINI_API_KEY)
# 2. Dans Cloud Run > Modifier et déployer une révision > Variables et secrets :
#    Liez les secrets aux variables d'environnement correspondantes.
# ==============================================================================

# Port d'écoute (injecté automatiquement par Cloud Run sur $PORT, valeur par défaut : 3000)
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. URL DE L'APPLICATION (APP_URL)
# ------------------------------------------------------------------------------
# Définissez ici l'adresse publique du service Cloud Run.
# Adresse Cloud Run actuelle :
APP_URL=https://ais-dev-lhrk3jauzs5yp25ycmq2ud-346996706457.europe-west2.run.app

# Une fois votre nom de domaine personnalisé connecté à Cloud Run, remplacez par :
# APP_URL=https://marketsenegal.com
# Les liens d'authentification, de réinitialisation et de redirection OAuth utiliseront cette URL.

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES POSTGRESQL (OBLIGATOIRE EN PRODUCTION SUR CLOUD RUN)
# ------------------------------------------------------------------------------
# En production sur Cloud Run, DATABASE_URL est STRICTEMENT OBLIGATOIRE.
# Le système refuse de démarrer s'il manque, car le conteneur Cloud Run est éphémère.
# (Le stockage local .data/marketsenegal.json est réservé au développement).
# EXEMPLE FICTIF (Instance Cloud SQL PostgreSQL avec Cloud SQL Auth Proxy ou adresse IP) :
DATABASE_URL=postgresql://postgres:EXEMPLE_MOT_DE_PASSE_POSTGRES_FICTIF_12345@/marketsenegal_db?host=/cloudsql/project-id:region:instance-name

# ------------------------------------------------------------------------------
# 3. STOCKAGE OBJET DES PHOTOS (S3 COMPATIBLE : CLOUDFLARE R2, GCS OU AWS S3)
# ------------------------------------------------------------------------------
# En production sur Cloud Run, STORAGE_PROVIDER=local est INTERDIT car le disque
# du conteneur est réinitialisé à chaque déploiement ou mise à l'échelle.
STORAGE_PROVIDER=s3

# Nom du bucket (ex: Cloudflare R2 ou bucket GCS avec interopérabilité S3)
S3_BUCKET_NAME=market-senegal-production-uploads
S3_REGION=auto
S3_ENDPOINT=https://EXEMPLE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=EXEMPLE_R2_OU_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=EXEMPLE_R2_OU_S3_SECRET_ACCESS_KEY

# Domaine CDN public optionnel pointant sur votre bucket (ex: https://cdn.marketsenegal.com)
S3_PUBLIC_DOMAIN=https://cdn.marketsenegal.com

# ------------------------------------------------------------------------------
# 4. SÉCURITÉ, SESSIONS & ADMINISTRATEUR PRINCIPAL
# ------------------------------------------------------------------------------
# Clé de signature cryptographique des jetons de session (min. 32 caractères aléatoires)
SESSION_SECRET=EXEMPLE_CLE_SECRETE_SESSION_MIN_32_CARACTERES_ALEATOIRES_XYZ789

# Clé secrète de secours
ADMIN_INIT_SECRET=EXEMPLE_CLE_INITIALISATION_ADMIN_SECRETE_987654

# Compte administrateur principal (strictement réservé à cette adresse) :
ADMIN_EMAIL=diengmoustapha910@gmail.com

# Mot de passe initial administrateur (renseigné UNIQUEMENT dans Secret Manager au déploiement)
# Le mot de passe n'est jamais stocké en clair (PBKDF2-SHA512 + sel).
# DÈS QUE LE COMPTE EST CRÉÉ, CE MÉCANISME D'INITIALISATION EST DÉFINITIVEMENT DÉSACTIVÉ.
ADMIN_INITIAL_PASSWORD=EXEMPLE_MotDePasseInitialAdmin2026!Securise

# ------------------------------------------------------------------------------
# 5. AUTHENTIFICATION CLIENT GOOGLE (OAUTH 2.0)
# ------------------------------------------------------------------------------
# Obtenez vos identifiants dans la console Google Cloud > APIs & Services > Credentials
# Créez un identifiant "Client ID OAuth 2.0" de type "Web Application".
#
# Origines JavaScript autorisées à déclarer dans Google Cloud Console :
#   - https://ais-dev-lhrk3jauzs5yp25ycmq2ud-346996706457.europe-west2.run.app
#   - https://ais-pre-lhrk3jauzs5yp25ycmq2ud-346996706457.europe-west2.run.app
#   - https://marketsenegal.com (après raccordement du domaine)
#
# URIs de redirection autorisées (callbacks) exactes à déclarer :
#   - https://ais-dev-lhrk3jauzs5yp25ycmq2ud-346996706457.europe-west2.run.app/api/auth/google/callback
#   - https://marketsenegal.com/api/auth/google/callback
#
# IMPORTANT : Un compte Google est TOUJOURS strictement assigné au rôle client.
# Aucun rôle vendeur ou administrateur ne peut être attribué via Google.
GOOGLE_CLIENT_ID=EXEMPLE_1234567890-abcdefg1234567.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=EXEMPLE_GOCSPX-votre_client_secret_google_fictif

# ------------------------------------------------------------------------------
# 6. EMAILS TRANSACTIONNELS (SMTP SÉCURISÉ)
# ------------------------------------------------------------------------------
# Noms exacts harmonisés pour l'envoi des liens de réinitialisation et notifications.
# En production, les e-mails ne fonctionneront pas tant que ces variables ne sont pas renseignées.
# L'application confirme l'envoi uniquement après un succès SMTP réel.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=EXEMPLE_SG.mot_de_passe_ou_cle_smtp_sendgrid_fictive
SMTP_FROM=contact@marketsenegal.sn

# ------------------------------------------------------------------------------
# 7. ASSISTANT & INTELLIGENCE ARTIFICIELLE (GEMINI API)
# ------------------------------------------------------------------------------
# Clé API Google AI Studio obtenue sur https://aistudio.google.com/
# Si non configurée, la messagerie normale client-vendeur reste 100% fonctionnelle
# et l'application indique clairement que l'IA attend sa clé sans simuler de fausses réponses.
GEMINI_API_KEY=EXEMPLE_AIzaSyD_Cle_Gemini_API_Studio_Fictive

# ------------------------------------------------------------------------------
# 8. PAIEMENTS SÉNÉGAL (WAVE & ORANGE MONEY)
# ------------------------------------------------------------------------------
# Les validations manuelles (Wave / Orange Money avec saisie et vérification
# des références de transaction par le vendeur et l'admin) sont 100% fonctionnelles.
# Ajoutez ces clés uniquement lorsque vos contrats Wave Business et Orange Developer seront signés.
WAVE_API_KEY=EXEMPLE_wave_sn_api_key_fictive
WAVE_SECRET_KEY=EXEMPLE_wave_sn_secret_key_fictive
WAVE_WEBHOOK_SECRET=EXEMPLE_wave_webhook_secret_fictif

ORANGE_MONEY_CLIENT_ID=EXEMPLE_om_client_id_fictif
ORANGE_MONEY_CLIENT_SECRET=EXEMPLE_om_client_secret_fictif
ORANGE_MONEY_MERCHANT_KEY=EXEMPLE_om_merchant_key_fictive
ORANGE_MONEY_WEBHOOK_SECRET=EXEMPLE_om_webhook_secret_fictif
